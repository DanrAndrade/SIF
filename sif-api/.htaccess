# Proteções da pasta da API (sif-api)

# Sem listagem de arquivos ao acessar a pasta direto
Options -Indexes

# Bloqueia download de dumps, backups e compactados (.sql, .zip, etc.)
<FilesMatch "\.(sql|zip|rar|7z|tar|gz|bak|log|ini|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Scripts de manutenção/diagnóstico NUNCA devem rodar pela web
# (se algum for enviado por engano ao servidor, fica bloqueado)
<FilesMatch "^(migrate.*|migration.*|cleanup_.*|repair_.*|converter_.*|gerar_senha|testeconexao)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Arquivos internos incluídos pelos endpoints (não são endpoints)
<FilesMatch "^(db|api_guard|image_utils|seo_lib)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>


# Fotos, PDFs e vídeos enviados pelo painel: o nome do arquivo é único
# (data + código), então o navegador pode guardar por bastante tempo.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType video/webm "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html
</IfModule>

# Currículos antigos ficaram soltos na raiz de uploads/ (antes da pasta cvs/).
# Só o download.php (com login) pode entregá-los.
<If "%{REQUEST_URI} =~ m#/uploads/[^/]+\.(pdf|docx?)$#i">
    Require all denied
</If>

# Navegador não "adivinha" tipo de arquivo (proteção extra para uploads)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
