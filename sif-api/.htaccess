# Proteções da pasta da API (sif-api)

# Sem listagem de arquivos ao acessar a pasta direto
Options -Indexes

# Bloqueia download de dumps, backups e compactados (.sql, .zip, etc.)
<FilesMatch "\.(sql|zip|rar|7z|tar|gz|bak|log|ini|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Scripts de manutenção/diagnóstico NUNCA devem rodar pela web
# (se algum for enviado por engano ao servidor, fica bloqueado)
<FilesMatch "^(migrate.*|migration.*|cleanup_.*|repair_.*|converter_.*|gerar_senha|testeconexao)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Arquivos internos incluídos pelos endpoints (não são endpoints)
<FilesMatch "^(db|api_guard|image_utils)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
